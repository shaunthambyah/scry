{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "worker/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
